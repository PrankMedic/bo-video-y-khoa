# Chép thành .env (cùng thư mục với file này) rồi điền giá trị. Không commit .env.

# PubMed: ncbi.nlm.nih.gov → Account settings → API Key Management (miễn phí)
PUBMED_API_KEY=
NCBI_EMAIL=

# Gemini API (tuỳ chọn): aistudio.google.com → API keys
# Dùng cho giọng AI (work/tts_gemini.py), skill goi-gemini và Antigravity CLI
GEMINI_API_KEY=

# Workflow n8n tự theo dõi chủ đề PubMed (tuỳ chọn, bỏ trống nếu không dùng)
N8N_SEED_URL=
N8N_SEED_TOKEN=
